        `</field><next><block type="variables_change" id="u^V2m$M]Ra;jEZ9TvRcQ"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field><value name="VALUE"><shadow type="math_number" id="d906H}RilSKW;mNM?XMY"><field name="NUM">10</field></shadow></value></block></next></block></statement></block></statement></block><block type="device_forever" id="o3z9WnZ,_5b:ys0_~:=5" x="2838" y="3"><comment pinned="false" h="80" w="160">This block of code is a stat cap. Basically if it detects that energy or happiness is greater than 50, it sets it 50. The game has a stat cap feature in order for balancing (preventing the user to get like 1000 hunger and happiness, then do nothing).</comment><data>{"commentRefs":[],"fieldData":{"~commentOffsetX":"16","~commentOffsetY":"16"}}</data><statement name="HANDLER"><block type="controls_if" id="|lXd,,uqc6W{^Co6b{;v"><value name="IF0"><shadow type="logic_boolean" id="QD]n@5gF5vQ+9OW(d9oM"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="81gp4HqC#w@cYmiVS[=)"><field name="OP">GT</field><value name="A"><shadow type="math_number" id="OBP8]+YrLO2JoodpTe)V"><field name="NUM">0</field></shadow><block type="variables_get" id="e?kws,H1Ej+L}zNuUi^l"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field></block></value><value name="B"><shadow type="math_number" id="cla/:::a8_{%hri`ewZE"><field name="NUM">50</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="?96MHCv4p@?YP3]g3{l)"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field><value name="VALUE"><shadow type="math_number" id="/RKBC?F9fxHp~ct6c[g3"><field name="NUM">50</field></shadow></value></block></statement><next><block type="controls_if" id="Mt.WwCMV0eKE*r@{/)fP"><value name="IF0"><shadow type="logic_boolean" id="KnRd6X#vEw^e9mmbS}~{"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="Tbsra^u^j[e8NFN.)Xgz"><field name="OP">GT</field><value name="A"><shadow type="math_number" id="gg]hFF)B=tqux5)