es for some reason.</comment><data>{"commentRefs":[],"fieldData":{"~commentOffsetX":"16","~commentOffsetY":"16"}}</data><statement name="HANDLER"><block type="device_clear_display" id="[@ZLfkfk)gp+?{i|5zI+"><next><block type="device_print_message" id="S6K9Oc-vx^,3Sww[jOOd"><value name="text"><shadow type="text" id="5zF}.VFXOn$juL1uESGQ"><field name="TEXT">ENERGY</field></shadow></value><next><block type="device_print_message" id="VO]rVsMp[f8MW:R@5Avv"><value name="text"><shadow type="text" id="vb7?57Om0#[0I+!(_Ix`"><field name="TEXT"></field></shadow><block type="variables_get" id="eh660Zl`g9OOS;-YfD5$"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field></block></value><next><block type="device_print_message" id=".OAMMR-*M[xn_6,~{U@5"><value name="text"><shadow type="text" id="j:u5n^1PC(+Mh%.EAYr7"><field name="TEXT">HAPPINESS</field></shadow></value><next><block type="device_print_message" id="C*mQj$83PfhQm,/4%r9b"><value name="text"><shadow type="text" id="Vo`4.WF284-F+|9=-,#*"><field name="TEXT"></field></shadow><block type="variables_get" id="#q*S3Rq[X2.K3y8|)Meh"><field name="VAR" id="]AF6sfj;NvlsEZJd^OSH">happiness</field></block></value></block></next></block></next></block></next></block></next></block></statement></block><block type="device_forever" id=":E(#d2t/NJcTp$?rj%dx" x="1657" y="0"><comment pinned="false" h="80" w="160">This block of code states that if any of the stats (energy and happiness) is below or equal to 0, the pet will die and its game over. In the else statement it states if the pet isn't dead, then it should lose -1 energy and happiness every 3 seconds, this is called a stat decay; we have this feature to punish people who do not take care of their pets.</comment><data>{"commentRefs":[],"fieldData":{"~commentOffsetX":"16","~commentOffsetY":"16"}}</data><statement name="HANDLER"><block type="controls_if" id="wo?qUeTM?S%SU?Vc6XVE"><mutation else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="6vD7qcj)cUQlgc{f(iwf"><field name="BOOL">TRUE</field></shadow><block type="logic_operation" id=";^;K{1wfYGZ%5$Q)UUQ="><field name="OP">OR</field><value name="A"><shadow type="logic_boolean" id="0~zPOcd=6!PZ.g{mVF-a"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="q5MD6Q~[Lm1%bOOG{XQ@"><field name="OP">LTE</field><value name="A"><shadow type="math_number" id=":o:j,rhpT,S.JZATie%]"><field name="NUM">0</field></shadow><block type="variables_get" id="hziZRljT-riev4_?Bnz,"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field></block></value><value name="B"><shadow type="math_number" id="$fhM1k_Ui[X)7B|F]fX."><field name="NUM">0</field></shadow></value></block></value><value name="B"><shadow type="logic_boolean" id="M?yQp}2-J*P)jQ!#5yfQ"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="?39/@yL28=?Km!Iblcn-"><field name="OP">LTE</field><value name="A"><shadow type="math_number" id="EcfCuTFyM634^zjRNhn*"><field name="NUM">0</field></shadow><block type="variables_get" id="1eGe$CRS2MxyC6UdhV[E"><field name="VAR" id="]AF6sfj;NvlsEZJd^OSH">happiness</field></block></value><value name="B"><shadow type="math_number" id="bF`VVh%kOXJ~s3X3%OzL"><field name="NUM">0</field></shadow></value></block></value></block></value><statement name="DO0"><block type="device_clear_display" id="#sV.5k.8{.iLjU]d)+-Q"><next><block type="game_game_over" id=")c;*3-M%),%?GsT@F$7?"></block></next></block></statement><statement name="ELSE"><block type="device_pause" id="r@SOpW:NxeV!_*#`qq]4"><value name="pause"><shadow type="timePicker" id="lwtIKfsr#^,2%o^%as6K"><field name="ms">3000</field></shadow></value><next><block type="variables_change" id="$/D(DtHaKd)=(j/PBcB5"><field name="VAR" id="h;LY-oA-eeQGx=X3Cz]p">energy</field><value name="VALUE"><shadow type="math_number" id="ix-Rx.7BK}HD^[4E=GdE"><field name="NUM">-1</field></shadow></value><next><block type="variables_change" id="IU~ps5/cCnzoyE$!LUBj"><field name="VAR" id="]AF6sfj;NvlsEZJd^OSH">happiness</field><value name=